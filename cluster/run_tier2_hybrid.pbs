#!/bin/bash
#PBS -N mediinsight_tier2_hybrid
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o mediinsight_tier2_hybrid.pbsout

set -e
cd "$PBS_O_WORKDIR" 2>/dev/null || cd ~/mediinsight_project/codes

LIVELOG="mediinsight_tier2_hybrid_live.log"

source ~/miniforge3/etc/profile.d/conda.sh
conda activate mediinsight

python3 -c "import vit_keras" 2>/dev/null || pip install --user vit-keras

{
echo "===== JOB INFO ====="
echo "Job ID: $PBS_JOBID"
echo "Running on node: $(hostname)"
echo "Start time: $(date)"
nvidia-smi --query-gpu=name,memory.total,memory.used --format=csv
echo "====================="

# HybridFusionNet: the new dual-branch CNN(DenseNet169)+ViT(ViT-B16) fusion
# architecture proposed for this project (see models_tier2_hybrid.py for the
# full rationale) -- two independently pretrained branches, concatenated
# embeddings, shared fusion head, trained with the same two-phase recipe.
# Runs as its own job so it can execute in parallel with the CNN-only and
# ViT-only jobs on a separate GPU; both branches are large, so batch size
# defaults lower (16) than the single-branch scripts.
INDEX_CSV="$HOME/mediinsight_project/data/mura_ehr_index.csv"

for REGION in XR_SHOULDER XR_ELBOW XR_HAND; do
    echo "===== Region: $REGION | HybridFusionNet (DenseNet169+ViT-B16) ====="
    python3 -u train_tier2_hybrid.py \
        --index-csv "$INDEX_CSV" \
        --region "$REGION" \
        --output-dir "$HOME/mediinsight_project/results/tier2_${REGION}_hybrid_densenet169_vitb16" \
        --cnn-backbone DenseNet169 --vit-variant vit_b16 \
        --dropout 0.5 --l2 1e-4 \
        --warmup-epochs 5 --finetune-epochs 60 \
        --save-probs
done

echo "===== JOB DONE ====="
echo "End time: $(date)"
} > "$LIVELOG" 2>&1
