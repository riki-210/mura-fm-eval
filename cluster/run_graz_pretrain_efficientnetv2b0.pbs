#!/bin/bash
#PBS -N graz_pre_efficientnetv2b0
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o graz_pre_efficientnetv2b0.pbsout

set -e
cd "$PBS_O_WORKDIR" 2>/dev/null || cd ~/mediinsight_project/codes

source ~/miniforge3/etc/profile.d/conda.sh
conda activate mediinsight
LIVELOG="graz_pre_efficientnetv2b0_live.log"
{
echo "===== JOB INFO ====="; echo "Job ID: $PBS_JOBID"; echo "Node: $(hostname)"; echo "Start: $(date)"; echo "====================="
python3 -u pretrain_graz_backbone.py \
    --index-csv "$HOME/mediinsight_project/data/graz_index.csv" \
    --output-weights "$HOME/mediinsight_project/codes/graz_pretrained_EfficientNetV2B0.weights.h5" \
    --backbone EfficientNetV2B0 --epochs 30
echo "===== JOB DONE ====="; echo "End: $(date)"
} > "$LIVELOG" 2>&1
