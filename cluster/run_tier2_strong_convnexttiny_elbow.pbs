#!/bin/bash
#PBS -N mediinsight_tier2_strong_convnexttiny_elbow
#PBS -q gpu
#PBS -l select=1:ncpus=4:ngpus=1:mem=32gb
#PBS -l walltime=48:00:00
#PBS -j oe
#PBS -o mediinsight_tier2_strong_convnexttiny_elbow.pbsout

set -e
cd "$PBS_O_WORKDIR" 2>/dev/null || cd ~/mediinsight_project/codes

LIVELOG="mediinsight_tier2_strong_convnexttiny_elbow_live.log"

source ~/miniforge3/etc/profile.d/conda.sh
conda activate mediinsight

{
echo "===== JOB INFO ====="
echo "Job ID: $PBS_JOBID"
echo "Running on node: $(hostname)"
echo "Start time: $(date)"
nvidia-smi --query-gpu=name,memory.total,memory.used --format=csv
echo "====================="

# ConvNeXtTiny, single region (XR_ELBOW) per job -- split out of the
# original all-3-regions run_tier2_strong_convnexttiny.pbs after that job
# hit the 24h walltime limit partway through XR_ELBOW's Phase 2 (epoch 15).
# ConvNeXtTiny runs ~80-100s/epoch-step (far slower than DenseNet/
# EfficientNet at this image size), so walltime is bumped to 48h here, not
# just split per-region, to give early stopping (patience=8) real room to
# trigger naturally instead of risking a repeat walltime kill.
INDEX_CSV="$HOME/mediinsight_project/data/mura_ehr_index.csv"

python3 -u train_tier2_strong.py \
    --index-csv "$INDEX_CSV" \
    --region "XR_ELBOW" \
    --output-dir "$HOME/mediinsight_project/results/tier2_XR_ELBOW_strong_ConvNeXtTiny" \
    --backbone ConvNeXtTiny \
    --dropout 0.5 --l2 1e-4 \
    --warmup-epochs 5 --finetune-epochs 60 \
    --save-probs

echo "===== JOB DONE ====="
echo "End time: $(date)"
} > "$LIVELOG" 2>&1
